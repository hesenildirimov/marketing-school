# Docker Compose səviyyəsində dəyişənlər (deploy/.env; staging üçün deploy/staging.env).
# Tətbiqin öz ayarları platform/.env-dədir (platform/.env.example). Real dəyərləri commit ETMƏYİN.
STACK=prod
IMAGE_TAG=latest
APP_ENV_FILE=../platform/.env          # staging: ../platform/.env.staging
HTTP_PORT=80                           # staging: 8080
HTTPS_PORT=443                         # staging: 8443 (Netlify staging proxy → https://origin.marketingschool.az:8443)
PG_HOST_PORT=5432                      # staging: 5433 (yalnız 127.0.0.1)
LETSENCRYPT_DIR=/etc/letsencrypt       # prod certbot yazır, staging yalnız oxuyur

# PostgreSQL rolları (init-roles.sh ilk başlanğıcda yaradır). Hər biri ayrı, uzun, təsadüfi.
DB_DATABASE=marketingschool
DB_PASSWORD=                           # ms_app (veb) — platform/.env DB_PASSWORD ilə eyni
DB_OWNER_PASSWORD=                     # ms_owner (yalnız miqrasiya)
DB_WORKER_PASSWORD=                    # ms_worker (worker, scheduler)
DB_BACKUP_PASSWORD=                    # ms_backup (host cron backup, /etc/ms-backup-<stack>.env)
# Superuser parolu: deploy/secrets/pg_superuser.txt (chmod 600, gitignore-dadır)

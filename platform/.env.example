# Marketing School platforması — nümunə konfiqurasiya. Real dəyərlər YALNIZ serverdəki .env-də.
APP_NAME="Marketing School"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://marketingschool.az
LANDING_URL=https://marketingschool.az
APP_LOCALE=az
APP_FALLBACK_LOCALE=az

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# PostgreSQL: üç rol (deploy/postgres/init-roles.sh)
DB_CONNECTION=pgsql            # worker konteynerində: pgsql_worker
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=marketingschool
DB_USERNAME=ms_app
DB_PASSWORD=
DB_OWNER_USERNAME=ms_owner     # yalnız miqrasiya zamanı lazımdır
DB_OWNER_PASSWORD=
DB_WORKER_USERNAME=ms_worker
DB_WORKER_PASSWORD=
DB_SSLMODE=disable             # eyni Docker şəbəkəsində

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_COOKIE=__Secure-ms_session
SESSION_PATH=/platform
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Netlify imzalı proxy (netlify.toml: signed = "PLATFORM_PROXY_SECRET"). Netlify-da eyni dəyər.
PROXY_REQUIRE_SIGNATURE=true
PLATFORM_PROXY_SECRET=

# SMTP (port 587, STARTTLS). SPF/DKIM/DMARC domen DNS-ində qurulmalıdır.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@marketingschool.az
MAIL_FROM_NAME="Marketing School"
MAIL_MAX_PER_MINUTE=20

# Bunny Stream (bölmə 4.3) — yalnız serverdə
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOST=                # məs. vz-xxxx.b-cdn.net
BUNNY_TOKEN_KEY=               # Pull Zone → Security → Token Authentication Key
VIDEO_PROVIDER=bunny           # test: fake

# Ödəniş (M6): manual | epoint
PAYMENT_PROVIDER=manual
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
EPOINT_API_URL=https://epoint.az/api/1

# ClamAV (clamd konteyneri)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

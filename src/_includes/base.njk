{%- from "icons.njk" import logo -%}
{%- set canon = slug | abs -%}
{%- set desc = seo_description -%}
{%- set org = {
  "@context": "https://schema.org", "@type": "EducationalOrganization", "@id": siteUrl + "/#organization",
  "name": site.name, "alternateName": site.alternate_names, "url": siteUrl + "/",
  "logo": {"@type": "ImageObject", "url": siteUrl + "/logo.png", "width": 512, "height": 512},
  "image": siteUrl + "/og.png", "description": site.description, 
  "address": {"@type": "PostalAddress", "streetAddress": site.address or undefined, "addressLocality": site.city, "addressCountry": site.country},
  "telephone": site.phone or undefined, "email": site.email or undefined,
  "areaServed": {"@type": "Country", "name": "Azerbaijan"}, "knowsAbout": site.knows_about,
  "sameAs": site.social | pluck("url")
} -%}
<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ seo_title }}</title>
<meta name="description" content="{{ desc }}">
<meta name="robots" content="{{ 'noindex, nofollow' if noindex else 'index, follow, max-image-preview:large, max-snippet:-1' }}">
{% if not noindex %}<link rel="canonical" href="{{ canon }}">{% endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="az_AZ">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ desc }}">
<meta property="og:url" content="{{ canon }}">
<meta property="og:image" content="{{ siteUrl }}/{{ image or 'og.png' }}">
<meta property="og:image:alt" content="{{ seo_title }}">
{% if ogType == 'article' %}<meta property="article:published_time" content="{{ date | ymd }}">
<meta property="article:modified_time" content="{{ (updated or date) | ymd }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ 'favicon.svg' | asset }}" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ 'logo.png' | asset }}">
<link rel="stylesheet" href="{{ 'style.css' | asset }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} Bloq" href="{{ siteUrl }}/rss.xml">
<link rel="alternate" type="text/plain" title="llms.txt" href="{{ siteUrl }}/llms.txt">
{% if not noindex %}<script type="application/ld+json">{{ org | json | safe }}</script>
{% for block in ld %}<script type="application/ld+json">{{ block | json | safe }}</script>
{% endfor %}{% if crumbs %}<script type="application/ld+json">{{ {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement": crumbs | crumbLd} | json | safe }}</script>{% endif %}{% endif %}
</head>
<body{% if heroDark %} data-hero="dark"{% endif %}>
<a class="skip" href="#main">Əsas məzmuna keç</a>
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="{{ '' | link }}">{{ logo() | safe }}<span>Marketing&nbsp;School</span></a>
    <nav class="nav" aria-label="Əsas naviqasiya">{% for n in [['', 'Ana səhifə'], ['marketinq-kursu', 'Marketinq'], ['digital-marketinq-kursu', 'Rəqəmsal marketinq'], ['bloq', 'Bloq'], ['faq', 'FAQ']] %}<a href="{{ n[0] | link }}"{% if n[0] == slug %} aria-current="page"{% endif %}>{{ n[1] }}</a>{% endfor %}</nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <p class="foot-brand">{{ logo() | safe }}<strong>{{ site.name }}</strong></p>
      <p class="muted">{{ site.tagline }}</p>
    </div>
    <div>
      <h2 class="foot-h">Kurslar</h2>
      <ul class="plain">{% for c in courses %}<li><a href="{{ c.slug | link }}">{{ c.name }}</a></li>{% endfor %}</ul>
    </div>
    <div>
      <h2 class="foot-h">Sayt</h2>
      <ul class="plain">
        <li><a href="{{ 'bloq' | link }}">Bloq</a></li>
        <li><a href="{{ 'faq' | link }}">Tez-tez verilən suallar</a></li>
        <li><a href="{{ '' | link }}#muraciet">Müraciət</a></li>
      </ul>
    </div>
    <div>
      <h2 class="foot-h">Əlaqə</h2>
      <ul class="plain">
        <li class="muted">{{ site.address or (site.city + ", Azərbaycan") }}</li>
        {% if site.phone %}<li><a href="tel:{{ site.phone | replace(' ', '') }}">{{ site.phone }}</a></li>{% endif %}
        {% if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
        {% for s in site.social %}<li><a rel="me noopener" target="_blank" href="{{ s.url }}">{{ s.name }}</a></li>{% endfor %}
      </ul>
    </div>
  </div>
  <div class="wrap foot-end"><p class="muted">© {{ site.updated | truncate(4, true, "") }} {{ site.name }} · {{ site.city }}, Azərbaycan · Son yenilənmə: <time datetime="{{ site.updated }}">{{ site.updated }}</time></p></div>
</footer>
<script>
(()=>{if(matchMedia("(prefers-reduced-motion:reduce)").matches||!("IntersectionObserver" in window))return;
const q='main section:not(.hero) .wrap>h2,main section:not(.hero) .wrap>.lede,.card,.posts li,.faq details,.cta-info,#muraciet form,.modules li,.src-card,.table-scroll,.summary,.keypoints,.stats div';
const io=new IntersectionObserver(es=>es.forEach(e=>{if(!e.isIntersecting)return;const el=e.target;el.classList.add("in");io.unobserve(el);setTimeout(()=>{el.classList.remove("rv","in");el.style.removeProperty("--d")},1200)}),{threshold:.1,rootMargin:"0px 0px -6% 0px"});
document.querySelectorAll(q).forEach(el=>{if(el.getBoundingClientRect().top<innerHeight*.92)return;el.classList.add("rv");el.style.setProperty("--d",Math.min([...el.parentNode.children].indexOf(el),4)*90+"ms");io.observe(el)})})();
</script>
</body>
</html>

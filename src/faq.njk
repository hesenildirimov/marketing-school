---
layout: base.njk
pagination: { data: langs, size: 1, alias: lang }
---
{%- set L = loc[lang] -%}{%- set u = L.ui -%}{%- set faq = L.faq -%}
<section class="hero"><div class="wrap">
  {% include "crumb.njk" %}
  <h1>{{ faq.h1 }}</h1>
  <p class="lede">{{ faq.lede }}</p>
  {% if u.lang_note %}<p class="lang-note">{{ u.lang_note }}</p>{% endif %}
  <nav class="faq-toc" aria-label="{{ u.topics }}">{% for g in faq.groups %}<a href="#{{ g.id }}">{{ g.name }}</a>{% endfor %}</nav>
  <p class="hint">{{ u.updated }}: <time datetime="{{ faq.updated }}">{{ faq.updated }}</time></p>
</div></section>
{% for g in faq.groups %}{% set faqItems = faq.items | where("group", g.id) %}{% if faqItems.length %}
<section id="{{ g.id }}" class="faq-group"><div class="wrap"><h2>{{ g.name }}</h2>{% include "faq-list.njk" %}</div></section>
{% endif %}{% endfor %}
{% set formTitle = u.faq_cta_title %}{% set formLede = u.faq_cta_lede %}{% include "form.njk" %}

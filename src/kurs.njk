---
layout: base.njk
heroDark: true
pagination: { data: coursePages, size: 1, alias: p }
---
{%- from "icons.njk" import ico -%}
{%- set c = p.c -%}{%- set L = loc[lang] -%}{%- set u = L.ui -%}
{%- set cFaq = L.faq.items | where("show_on", c.slug) -%}
<section class="hero dark"><div class="wrap">
  {% include "crumb.njk" %}
  <p class="eyebrow">{{ c.eyebrow }}</p>
  <h1>{{ c.h1 }}</h1>
  <p class="lede">{{ c.lede }}</p>
  {% if u.lang_note %}<p class="lang-note">{{ u.lang_note }}</p>{% endif %}
  <p class="price-tag">{{ u.price_line }} <small>· {{ u.price_note }}</small></p>
  <ul class="meta-row">{% for ch in c.chips %}<li>{{ ch }}</li>{% endfor %}</ul>
  <div class="btns"><a class="btn" href="#muraciet">{{ u.cta_demo }}</a><a class="btn btn-ghost" href="#proqram">{{ u.see_program }}</a></div>
  <div class="stats"><div><b>99 AZN</b><span>{{ u.price_per }}</span></div><div><b>{{ c.modules.length }}</b><span>{{ u.stat_modules }}</span></div><div><b>{{ u.stat_live_value }}</b><span>{{ u.stat_live }}</span></div><div><b>1:1</b><span>{{ u.stat_mentoring }}</span></div></div>
</div></section>
<section><div class="wrap"><p class="eyebrow">{{ u.short_answer }}</p><h2>{{ u.about_course }}</h2>
  <p class="summary">{{ c.summary }}</p>
  <p class="prose">{{ c.overview }}</p>
  <div class="table-scroll prose"><table class="facts"><caption>{{ c.name }} — {{ u.key_facts }}</caption><tbody>{% for f in c.facts %}<tr><th scope="row">{{ f.label }}</th><td>{{ f.value }}</td></tr>{% endfor %}</tbody></table></div>
  <p class="hint">{{ u.updated }}: <time datetime="{{ c.updated }}">{{ c.updated }}</time></p>
</div></section>
<section class="sec-tint-c"><div class="wrap"><div class="grid">
  <article class="card"><h2 class="card-h">{{ u.for_whom }}</h2><ul class="tick">{% for a in c.audience %}<li>{{ a }}</li>{% endfor %}</ul></article>
  <article class="card"><h2 class="card-h">{{ u.outcomes }}</h2><ul class="tick">{% for o in c.outcomes %}<li>{{ o }}</li>{% endfor %}</ul></article>
</div>{% if c.tools %}<p class="tools"><b>{{ u.tools }}:</b> {{ c.tools | join(", ") }}</p>{% endif %}</div></section>
<section><div class="wrap"><p class="eyebrow">{{ u.diff_eyebrow }}</p><h2>{{ u.diff_title }}</h2><div class="grid">{% for f in c.features %}<article class="card"><h3>{{ f.title }}</h3><p>{{ f.text }}</p></article>{% endfor %}</div></div></section>
<section id="proqram"><div class="wrap"><p class="eyebrow">{{ u.program }}</p><h2>{{ u.full_program | fill({n: c.modules.length}) }}</h2>
  <p class="lede">{{ u.program_lede }}</p>
  <ol class="modules">{% for m in c.modules %}<li><strong>{{ m.title }}</strong><span>{{ m.text }}</span></li>{% endfor %}</ol></div></section>
<section id="telimci" class="sec-tint-c"><div class="wrap"><p class="eyebrow">{{ u.instructor }}</p>{% set pr = c.instructor %}<article class="card person wide"><div class="p-head"><img class="avatar" src="{{ pr.photo | asset }}" alt="{{ pr.name }}" width="64" height="64" loading="lazy"><div><h2 class="card-h">{{ pr.name }}</h2><small>{{ pr.role }}</small></div></div><ul class="tick">{% for h in pr.highlights %}<li>{{ h }}</li>{% endfor %}</ul>{% if pr.linkedin %}<p><a rel="me noopener" target="_blank" href="{{ pr.linkedin }}">{{ u.linkedin }}</a></p>{% endif %}</article></div></section>
{% if cFaq.length %}<section id="suallar"><div class="wrap"><p class="eyebrow">FAQ</p><h2>{{ c.name }} — {{ u.questions }}</h2>
  {% set faqItems = cFaq %}{% include "faq-list.njk" %}
  <div class="btns"><a class="btn btn-ghost" href="{{ routes.faq[lang] | link }}">{{ u.all_questions }} →</a></div></div></section>{% endif %}
<section><div class="wrap"><h2>{{ u.other_program }}</h2><div class="grid">
  {% for o in L.courses %}{% if o.slug != c.slug %}<article class="card"><h3><a href="{{ routes.course[o.slug][lang] | link }}">{{ o.name }}</a></h3><p>{{ o.lede }}</p><p class="price-tag">{{ u.price_line }}</p><p><a href="{{ routes.course[o.slug][lang] | link }}">{{ u.see_program }} →</a></p></article>{% endif %}{% endfor %}
</div></div></section>
{% set slugForForm = c.slug %}{% include "form.njk" %}

---
layout: base.njk
noindex: true
eleventyExcludeFromCollections: true
pagination: { data: langs, size: 1, alias: lang }
---
{%- set L = loc[lang] -%}
<section class="hero"><div class="wrap">
  <h1>{{ L.site.thanks.title }}</h1>
  <p class="lede">{{ L.site.thanks.text }}</p>
  <div class="btns"><a class="btn btn-ghost" href="{{ routes.blog[lang] | link }}">{{ L.ui.blog }}</a><a class="btn btn-ghost" href="{{ routes.home[lang] | link }}">{{ L.ui.home }}</a></div>
</div></section>
